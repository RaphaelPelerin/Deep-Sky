{
  "name": "deep-sky",
  "version": "0.1.0",
  "description": "A living, GPU-rendered cosmic background for the web: nebula, aurora, light beams and interactive stars, rendered off the main thread.",
  "keywords": [
    "background",
    "animated-background",
    "webgl",
    "shader",
    "nebula",
    "aurora",
    "starfield",
    "stars",
    "particles",
    "galaxy",
    "space",
    "hero",
    "landing-page",
    "web-worker",
    "offscreencanvas",
    "web-component",
    "react",
    "vue",
    "svelte",
    "angular"
  ],
  "license": "MIT",
  "author": "Raphael Pellerin",
  "homepage": "https://deep-sky-omega.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RaphaelPelerin/deep-sky.git"
  },
  "bugs": {
    "url": "https://github.com/RaphaelPelerin/deep-sky/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/deep-sky.iife.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "default": "./dist/svelte.js"
    },
    "./worker": "./dist/worker.iife.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/deep-sky.iife.js",
  "jsdelivr": "./dist/deep-sky.iife.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "capture": "node scripts/capture.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "publint": "^0.3.25",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  }
}
